# ==============================================================================
# rekuiper Docker Compose Environment Configuration
# ==============================================================================
# Copy this file to .env in the deploy/docker directory to customize your deployment:
#   cp .env.example .env

# Container image and tag
REKUIPER_IMAGE=ankurkrp/rekuiper
REKUIPER_VERSION=0.502-beta

# Published Host Ports
REKUIPER_REST_PORT=9081
REKUIPER_PROMETHEUS_PORT=20499
MOSQUITTO_PORT=1883
REDIS_PORT=6379

# Engine Logging & Debugging
# Supported log levels: debug | info | warn | error | fatal
KUIPER__BASIC__LOGLEVEL=info
KUIPER__BASIC__CONSOLELOG=true
KUIPER__BASIC__DEBUG=false
RUST_LOG=info

# Prometheus Metrics
KUIPER__BASIC__PROMETHEUS=true
KUIPER__BASIC__PROMETHEUSPORT=20499

# Security & Authentication (enable RSA JWT validation on REST API)
KUIPER__BASIC__AUTHENTICATION=false

# Timezone (e.g. UTC, America/New_York, Europe/London, Local)
KUIPER__BASIC__TIMEZONE=Local

# Default Upstream MQTT Broker for Source Streams
MQTT_SOURCE__DEFAULT__SERVER=tcp://mqtt-broker:1883
